# Copy to .env and fill values. Never commit .env.
# Rotate any credentials that were previously in secrets.js or chat logs.

PORT=3000
NODE_ENV=development

# Required
DB_LINK=
JWTSECRET=

# Frontend origin for CORS + email links (e.g. http://localhost:3001)
FRONTEND_URL=http://localhost:3001

# strict | lax | none. Use none when the site and API are different hosts (Render).
COOKIE_SAME_SITE=lax

# Admin seed (ensureAdminUser) — use a strong unique password
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=FoodApp Admin

# Optional reviewer demo account (pre-verified). Never commit real values.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=FoodApp Demo

# Gmail (or SMTP) for verification / reset / contact
APP_EMAIL=
APP_PASSWORD=

# Razorpay
KEY_ID=
KEY_SECRET=
WEBHOOK_SECRET=

# Stripe (optional, beside Razorpay). Put live values only in host env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry (optional). Leave empty to disable. Do not commit a real DSN.
SENTRY_DSN=

# Hugging Face (optional; needed for image generation scripts)
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
HF_IMAGE_FALLBACK_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# RAG / local models (optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1
VECTOR_INDEX_NAME=rag_embedding_index
SD_BASE_URL=http://127.0.0.1:7860
